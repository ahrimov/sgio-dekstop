<?xml version="1.0" encoding="UTF-8"?>
<!--
  UTE_SEM.xml — SQLite-адаптированные SQL-запросы для Electron-приложения.

  ╔══════════════════════════════════════════════════════════════════════════╗
  ║  ВАЖНО ДЛЯ РЕВЬЮ                                                        ║
  ║                                                                          ║
  ║  Оригинальный UTE_SEM.xml недоступен в репозитории (внешний файл        ║
  ║  gis-core/config/UTE_SEM.xml). Все SQL-запросы ниже написаны            ║
  ║  САМОСТОЯТЕЛЬНО на основе анализа JS-сервисов и имён полей.             ║
  ║                                                                          ║
  ║  Каждый запрос помечен одним из статусов:                               ║
  ║    [NEEDS_REVIEW] — написан по предположению, требует сверки с Oracle   ║
  ║    [VERIFIED]     — сверен с оригинальным Oracle-запросом               ║
  ║                                                                          ║
  ║  Перед запуском в production необходимо:                                ║
  ║    1. Получить оригинальный UTE_SEM.xml из gis-core                     ║
  ║    2. Сверить каждый запрос с Oracle-оригиналом                         ║
  ║    3. Адаптировать Oracle-специфичный синтаксис для SQLite              ║
  ║    4. Заменить статус [NEEDS_REVIEW] на [VERIFIED]                      ║
  ╚══════════════════════════════════════════════════════════════════════════╝

  Структура XML (должна точно соответствовать шаблону camaro в IOUtils.parseXml):
    - SELECT: <select><dbQuery><query>SQL</query></dbQuery></select>
    - INSERT/UPDATE/DELETE: <update|insert|delete><dbCommand><query>SQL</query></dbCommand></update|insert|delete>
    - OUTPUT-параметры: <var name="..." default="SELECT ..."/>  внутри dbCommand/dbQuery
    - Входные параметры: <param name="..."/> внутри dbCommand/dbQuery

  Параметры передаются через better-sqlite3 именованными биндингами: :PARAM_NAME

  Таблицы (SQLite-схема описана в db/schema.sql):
    ILI_INSPECTION       — отчёты ВТД
    ILI_DATA             — дефекты/швы/линейные объекты
    ANOMALY_EXTENSION_CL — справочник аномалий (расширенный)
    ILI_PIPE_LENGTH      — длины труб
    EVENT_RANGE          — диапазоны событий (координаты)
    ILI_CONTROL_POINT    — контрольные точки (реперы)
    STATION_POINT        — геодезические пикеты
    ROUTE                — маршруты/трубопроводы
-->
<root>

  <!-- ============================================================
       ILI IMPORT XML
       ============================================================ -->

  <!--
    [NEEDS_REVIEW] ILI_ILI_ZIP_IMP_C_55_9
    Загрузка справочника типов аномалий.
    Источник: анализ IliImportXml.checkTypes() — читает поля CODE и EXTENDED_DESCRIPTION.
    Oracle-оригинал: неизвестен, предположительно SELECT из PODS.ANOMALY_EXTENSION_CL.
    Параметры: нет
    Возвращает: CODE, EXTENDED_DESCRIPTION
  -->
  <data id="ILI_ILI_ZIP_IMP_C_55_9">
    <select>
      <dbQuery>
        <query>
SELECT
  CODE,
  EXTENDED_DESCRIPTION
FROM ANOMALY_EXTENSION_CL
ORDER BY CODE
        </query>
      </dbQuery>
    </select>
  </data>

  <!--
    [NEEDS_REVIEW] ILI_ILI_ZIP_IMP_C_55_7
    Создание записи отчёта ВТД в ILI_INSPECTION.
    Источник: IliImportXmlService.js — читает outputParams.ILI_INSPECTION_ID и outputParams.EVENT_ID.
    Oracle-оригинал: предположительно MERGE INTO или INSERT с RETURNING.
    SQLite: INSERT + SELECT last_insert_rowid() для получения ID.

    Входные параметры (из params.data):
      :ROUTE_ID, :KM_START, :KM_END, :DATE, :COMPANY, :FORMAT,
      :SOURCE_GCL, :PODS_USER, :FIRST_WELD_NUMBER

    OUTPUT: ILI_INSPECTION_ID, EVENT_ID (через var/@default)

    ⚠ NEEDS_REVIEW: структура таблицы ILI_INSPECTION и имена колонок
      могут отличаться от Oracle-оригинала.
  -->
  <data id="ILI_ILI_ZIP_IMP_C_55_7">
    <update>
      <dbCommand>
        <var name="ILI_INSPECTION_ID" default="SELECT last_insert_rowid() AS ILI_INSPECTION_ID"/>
        <var name="EVENT_ID"          default="SELECT last_insert_rowid() AS EVENT_ID"/>
        <param name="ROUTE_ID"/>
        <param name="KM_START"/>
        <param name="KM_END"/>
        <param name="DATE"/>
        <param name="COMPANY"/>
        <param name="FORMAT"/>
        <param name="SOURCE_GCL"/>
        <param name="PODS_USER"/>
        <param name="FIRST_WELD_NUMBER"/>
        <query>
INSERT INTO ILI_INSPECTION (
  ROUTE_ID,
  KM_START,
  KM_END,
  INSPECTION_DATE,
  COMPANY,
  FORMAT,
  SOURCE_GCL,
  CREATED_BY,
  FIRST_WELD_NUMBER,
  IS_DIRTY
) VALUES (
  :ROUTE_ID,
  :KM_START,
  :KM_END,
  :DATE,
  :COMPANY,
  :FORMAT,
  :SOURCE_GCL,
  :PODS_USER,
  :FIRST_WELD_NUMBER,
  1
)
        </query>
      </dbCommand>
    </update>
  </data>

  <!--
    [NEEDS_REVIEW] ILI_ILI_ZIP_IMP_C_55_8
    Вставка строк дефектов/швов/линейных объектов в ILI_DATA.
    Вызывается через dbWriter (построчно).
    Источник: IliImportXmlService.parseSourceFile() — список полей взят из XPath-шаблона.
    Oracle-оригинал: предположительно INSERT INTO PODS.ILI_DATA.

    ⚠ NEEDS_REVIEW: имена колонок таблицы ILI_DATA могут отличаться.
      Особенно: SRV_DISTRICT_GCL (проставляется setSrvDistrictId через gdal).
  -->
  <data id="ILI_ILI_ZIP_IMP_C_55_8">
    <insert>
      <dbCommand>
        <param name="ILI_INSPECTION_ID"/>
        <param name="WELD_NUMBER"/>
        <param name="ABSOLUTE_ODOMETER"/>
        <param name="AVERAGE_DEPTH"/>
        <param name="LENGTH"/>
        <param name="WIDTH"/>
        <param name="ORIENTATION_DEG"/>
        <param name="BPR_PIG"/>
        <param name="MILEPOST"/>
        <param name="NOMINAL_WALL_THICKNESS"/>
        <param name="X"/>
        <param name="Y"/>
        <param name="Z"/>
        <param name="SOURCE"/>
        <param name="US_WELD_ODOMETER"/>
        <param name="DS_WELD_ODOMETER"/>
        <param name="US_WELD_NUMBER"/>
        <param name="ANOMALY_TYPE_CL"/>
        <param name="FEATURE_DESCRIPTION"/>
        <param name="DL_TUBE"/>
        <param name="DESCRIPTION"/>
        <param name="COMMENTS"/>
        <param name="SRV_DISTRICT_GCL"/>
        <query>
INSERT INTO ILI_DATA (
  ILI_INSPECTION_ID,
  WELD_NUMBER,
  ABSOLUTE_ODOMETER,
  AVERAGE_DEPTH,
  LENGTH,
  WIDTH,
  ORIENTATION_DEG,
  BPR_PIG,
  MILEPOST,
  NOMINAL_WALL_THICKNESS,
  X,
  Y,
  Z,
  SOURCE,
  US_WELD_ODOMETER,
  DS_WELD_ODOMETER,
  US_WELD_NUMBER,
  ANOMALY_TYPE_CL,
  FEATURE_DESCRIPTION,
  DL_TUBE,
  DESCRIPTION,
  COMMENTS,
  SRV_DISTRICT_GCL
) VALUES (
  :ILI_INSPECTION_ID,
  :WELD_NUMBER,
  :ABSOLUTE_ODOMETER,
  :AVERAGE_DEPTH,
  :LENGTH,
  :WIDTH,
  :ORIENTATION_DEG,
  :BPR_PIG,
  :MILEPOST,
  :NOMINAL_WALL_THICKNESS,
  :X,
  :Y,
  :Z,
  :SOURCE,
  :US_WELD_ODOMETER,
  :DS_WELD_ODOMETER,
  :US_WELD_NUMBER,
  :ANOMALY_TYPE_CL,
  :FEATURE_DESCRIPTION,
  :DL_TUBE,
  :DESCRIPTION,
  :COMMENTS,
  :SRV_DISTRICT_GCL
)
        </query>
      </dbCommand>
    </insert>
  </data>

  <!--
    [NEEDS_REVIEW] ILI_ILI_ZIP_IMP_C_55_1
    Постобработка: заполнение ANOMALY_CODE для дефектов отчёта
    по справочнику ANOMALY_EXTENSION_CL.
    Источник: IliImportXmlService.js — шаг "prepare_data" после вставки дефектов.
    Oracle-оригинал: предположительно UPDATE или MERGE с подзапросом к ANOMALY_EXTENSION_CL.

    ⚠ NEEDS_REVIEW: в Oracle может быть другая логика сопоставления (LIKE, REGEXP и т.д.).
    Параметр: :ILI_INSPECTION_ID
  -->
  <data id="ILI_ILI_ZIP_IMP_C_55_1">
    <update>
      <dbCommand>
        <param name="ILI_INSPECTION_ID"/>
        <query>
UPDATE ILI_DATA
SET ANOMALY_CODE = (
  SELECT aec.CODE
  FROM ANOMALY_EXTENSION_CL aec
  WHERE UPPER(ILI_DATA.ANOMALY_TYPE_CL) = UPPER(aec.EXTENDED_DESCRIPTION)
  LIMIT 1
)
WHERE ILI_INSPECTION_ID = :ILI_INSPECTION_ID
  AND SOURCE != 'WLD'
        </query>
      </dbCommand>
    </update>
  </data>

  <!--
    [NEEDS_REVIEW] ILI_ILI_ZIP_IMP_C_55_4
    Постобработка: простановка номеров швов на дефектах (SQL-метод).
    Источник: IliImportXmlService.js — шаг "set_weld_nums_old".
    Oracle-оригинал: предположительно UPDATE с аналитическими функциями (LAG/LEAD).
    SQLite не поддерживает LAG/LEAD в UPDATE напрямую — используем подзапрос.

    ⚠ NEEDS_REVIEW: Oracle-версия может использовать другой алгоритм.
    Параметр: :ILI_INSPECTION_ID
  -->
  <data id="ILI_ILI_ZIP_IMP_C_55_4">
    <update>
      <dbCommand>
        <param name="ILI_INSPECTION_ID"/>
        <query>
UPDATE ILI_DATA
SET WELD_NUMBER = (
  SELECT w.WELD_NUMBER
  FROM ILI_DATA w
  WHERE w.ILI_INSPECTION_ID = ILI_DATA.ILI_INSPECTION_ID
    AND w.SOURCE = 'WLD'
    AND w.ABSOLUTE_ODOMETER &lt;= ILI_DATA.ABSOLUTE_ODOMETER
  ORDER BY w.ABSOLUTE_ODOMETER DESC
  LIMIT 1
)
WHERE ILI_INSPECTION_ID = :ILI_INSPECTION_ID
  AND SOURCE != 'WLD'
  AND (WELD_NUMBER IS NULL OR WELD_NUMBER = '')
        </query>
      </dbCommand>
    </update>
  </data>

  <!--
    [NEEDS_REVIEW] ILI_ILI_ZIP_IMP_C_55_5
    Постобработка: заполнение ILI_PIPE_LENGTH из данных ВТД (швы WLD).
    Источник: IliImportXmlService.js — шаг "prepare_pipe_len".
    Oracle-оригинал: предположительно INSERT INTO PODS.ILI_PIPE_LENGTH SELECT ... FROM PODS.ILI_DATA.

    ⚠ NEEDS_REVIEW: структура таблицы ILI_PIPE_LENGTH и условия фильтрации.
    Параметр: :ILI_INSPECTION_ID
  -->
  <data id="ILI_ILI_ZIP_IMP_C_55_5">
    <update>
      <dbCommand>
        <param name="ILI_INSPECTION_ID"/>
        <query>
INSERT OR IGNORE INTO ILI_PIPE_LENGTH (
  ILI_INSPECTION_ID,
  WELD_NUMBER,
  ABSOLUTE_ODOMETER,
  DL_TUBE,
  NOMINAL_WALL_THICKNESS
)
SELECT
  ILI_INSPECTION_ID,
  WELD_NUMBER,
  ABSOLUTE_ODOMETER,
  DL_TUBE,
  NOMINAL_WALL_THICKNESS
FROM ILI_DATA
WHERE ILI_INSPECTION_ID = :ILI_INSPECTION_ID
  AND SOURCE = 'WLD'
  AND DL_TUBE IS NOT NULL
  AND DL_TUBE &gt; 0
        </query>
      </dbCommand>
    </update>
  </data>

  <!--
    [NEEDS_REVIEW] ILI_ILI_ZIP_IMP_C_55_0
    Получение ROUTE_ID для отчёта (для последующего расчёта).
    Источник: IliImportXmlService.js — шаг "calc_report", читает поле ROUTE_ID.
    Oracle-оригинал: предположительно SELECT ROUTE_ID FROM PODS.ILI_INSPECTION WHERE ...

    Параметр: :ILI_INSPECTION_ID
    Возвращает: ROUTE_ID
  -->
  <data id="ILI_ILI_ZIP_IMP_C_55_0">
    <select>
      <dbQuery>
        <param name="ILI_INSPECTION_ID"/>
        <query>
SELECT ROUTE_ID
FROM ILI_INSPECTION
WHERE ILI_INSPECTION_ID = :ILI_INSPECTION_ID
LIMIT 1
        </query>
      </dbQuery>
    </select>
  </data>


  <!-- ============================================================
       ILI INSP PROC (общий для LinkRepers и IliInspCalc)
       ============================================================ -->

  <!--
    [NEEDS_REVIEW] ILI_ILI_INSP_PROC_C_1
    Получение ROUTE_ID по P_REPORT_ID (ILI_INSPECTION_ID).
    Источник: LinkRepersService.js и IliInspCalcService.js — оба читают поле ROUTE_ID.
    Oracle-оригинал: предположительно SELECT ROUTE_ID FROM PODS.ILI_INSPECTION WHERE ...

    Параметр: :P_REPORT_ID
    Возвращает: ROUTE_ID
  -->
  <data id="ILI_ILI_INSP_PROC_C_1">
    <select>
      <dbQuery>
        <param name="P_REPORT_ID"/>
        <query>
SELECT ROUTE_ID
FROM ILI_INSPECTION
WHERE ILI_INSPECTION_ID = :P_REPORT_ID
LIMIT 1
        </query>
      </dbQuery>
    </select>
  </data>


  <!-- ============================================================
       LINK REPERS — привязка реперов к пикетам
       ============================================================ -->

  <!--
    [NEEDS_REVIEW] CALC_LINK_REPERS_4
    Отвязка реперов (сброс привязки) перед пересчётом.
    Источник: LinkRepersService.js — шаг "unlink_repers".
    Oracle-оригинал: предположительно UPDATE PODS.ILI_CONTROL_POINT SET ... WHERE ...

    ⚠ NEEDS_REVIEW: имена колонок таблицы ILI_CONTROL_POINT.
    Параметр: :P_REPORT_ID
  -->
  <data id="CALC_LINK_REPERS_4">
    <update>
      <dbCommand>
        <param name="P_REPORT_ID"/>
        <query>
UPDATE ILI_CONTROL_POINT
SET
  LINKED_STATION  = NULL,
  LINKED_DISTANCE = NULL,
  LINKED_ROUTE_ID = NULL,
  IS_LINKED       = 0
WHERE ILI_INSPECTION_ID = :P_REPORT_ID
        </query>
      </dbCommand>
    </update>
  </data>

  <!--
    [NEEDS_REVIEW] CALC_LINK_REPERS_1
    Загрузка реперов (контрольных точек) для привязки.
    Источник: LinkRepersService.js — шаг "load_repers", таблица REP.
    Oracle-оригинал: предположительно SELECT из PODS.ILI_CONTROL_POINT.
    Алгоритм LinkRepers.process() ожидает поля: ID, ABSOLUTE_ODOMETER, X, Y, Z,
      STATION, DISTANCE, ROUTE_ID.

    ⚠ NEEDS_REVIEW: точный список полей и условия фильтрации.
    Параметр: :P_REPORT_ID
  -->
  <data id="CALC_LINK_REPERS_1">
    <select>
      <dbQuery>
        <param name="P_REPORT_ID"/>
        <query>
SELECT
  ILI_CONTROL_POINT_ID AS ID,
  ABSOLUTE_ODOMETER,
  X,
  Y,
  Z,
  STATION,
  DISTANCE,
  ROUTE_ID
FROM ILI_CONTROL_POINT
WHERE ILI_INSPECTION_ID = :P_REPORT_ID
ORDER BY ABSOLUTE_ODOMETER
        </query>
      </dbQuery>
    </select>
  </data>

  <!--
    [NEEDS_REVIEW] CALC_LINK_REPERS_2
    Загрузка геодезических пикетов (GP) для привязки реперов.
    Источник: LinkRepersService.js — шаг "load_repers", таблица GP.
    Oracle-оригинал: предположительно SELECT из PODS.STATION_POINT.
    Алгоритм LinkRepers.process() ожидает поля: ID, STATION, DISTANCE, X, Y, Z.

    ⚠ NEEDS_REVIEW: точный список полей, имя таблицы и условия фильтрации.
    Параметр: :P_ROUTE_ID
  -->
  <data id="CALC_LINK_REPERS_2">
    <select>
      <dbQuery>
        <param name="P_ROUTE_ID"/>
        <query>
SELECT
  STATION_POINT_ID AS ID,
  STATION,
  DISTANCE,
  X,
  Y,
  Z
FROM STATION_POINT
WHERE ROUTE_ID = :P_ROUTE_ID
ORDER BY STATION, DISTANCE
        </query>
      </dbQuery>
    </select>
  </data>

  <!--
    [NEEDS_REVIEW] CALC_LINK_REPERS_3
    Запись результатов привязки реперов (UPDATE ILI_CONTROL_POINT).
    Вызывается через dbWriter (построчно).
    Источник: LinkRepersService.js — шаг "update_control_points".
    Oracle-оригинал: предположительно UPDATE PODS.ILI_CONTROL_POINT SET ... WHERE ID=...

    ⚠ NEEDS_REVIEW: имена колонок результата LinkRepers.process() (RES_REP).
      Нужно сверить что именно возвращает LinkRepers и как это маппится на таблицу.
    Поля из RES_REP: :ID, :LINKED_STATION, :LINKED_DISTANCE, :LINKED_ROUTE_ID, :IS_LINKED
  -->
  <data id="CALC_LINK_REPERS_3">
    <insert>
      <dbCommand>
        <param name="ID"/>
        <param name="LINKED_STATION"/>
        <param name="LINKED_DISTANCE"/>
        <param name="LINKED_ROUTE_ID"/>
        <param name="IS_LINKED"/>
        <query>
UPDATE ILI_CONTROL_POINT
SET
  LINKED_STATION  = :LINKED_STATION,
  LINKED_DISTANCE = :LINKED_DISTANCE,
  LINKED_ROUTE_ID = :LINKED_ROUTE_ID,
  IS_LINKED       = :IS_LINKED
WHERE ILI_CONTROL_POINT_ID = :ID
        </query>
      </dbCommand>
    </insert>
  </data>


  <!-- ============================================================
       CALC DEF — расчёт координат дефектов
       ============================================================ -->

  <!--
    [NEEDS_REVIEW] CALC_CALC_DEF_1
    Загрузка дефектов с привязанными реперами для расчёта координат.
    Источник: IliInspCalcService.js — шаг "load_def", таблица DATA.
    Oracle-оригинал: предположительно SELECT из PODS.ILI_DATA с JOIN на PODS.ILI_CONTROL_POINT.
    Алгоритм IliInspCalc.process() ожидает поля DATA и PIKET для интерполяции.

    ⚠ NEEDS_REVIEW: точный список полей, условия JOIN и фильтрации.
      Особенно: как реперы (US/DS) связаны с дефектами в Oracle-схеме.
    Параметр: :P_REPORT_ID
  -->
  <data id="CALC_CALC_DEF_1">
    <select>
      <dbQuery>
        <param name="P_REPORT_ID"/>
        <query>
SELECT
  d.ILI_DATA_ID,
  d.ABSOLUTE_ODOMETER,
  d.SOURCE,
  d.US_WELD_ODOMETER,
  d.DS_WELD_ODOMETER,
  d.WELD_NUMBER,
  d.US_WELD_NUMBER,
  d.ANOMALY_TYPE_CL,
  d.FEATURE_DESCRIPTION,
  d.AVERAGE_DEPTH,
  d.LENGTH,
  d.WIDTH,
  d.ORIENTATION_DEG,
  d.NOMINAL_WALL_THICKNESS,
  d.X,
  d.Y,
  d.Z,
  cp_us.ABSOLUTE_ODOMETER AS REP_US_ODOMETER,
  cp_us.LINKED_STATION    AS REP_US_STATION,
  cp_us.LINKED_DISTANCE   AS REP_US_DISTANCE,
  cp_us.LINKED_ROUTE_ID   AS REP_US_ROUTE_ID,
  cp_ds.ABSOLUTE_ODOMETER AS REP_DS_ODOMETER,
  cp_ds.LINKED_STATION    AS REP_DS_STATION,
  cp_ds.LINKED_DISTANCE   AS REP_DS_DISTANCE,
  cp_ds.LINKED_ROUTE_ID   AS REP_DS_ROUTE_ID
FROM ILI_DATA d
LEFT JOIN ILI_CONTROL_POINT cp_us
  ON cp_us.ILI_INSPECTION_ID = d.ILI_INSPECTION_ID
 AND cp_us.SOURCE = 'WLD'
 AND cp_us.ABSOLUTE_ODOMETER = d.US_WELD_ODOMETER
LEFT JOIN ILI_CONTROL_POINT cp_ds
  ON cp_ds.ILI_INSPECTION_ID = d.ILI_INSPECTION_ID
 AND cp_ds.SOURCE = 'WLD'
 AND cp_ds.ABSOLUTE_ODOMETER = d.DS_WELD_ODOMETER
WHERE d.ILI_INSPECTION_ID = :P_REPORT_ID
ORDER BY d.ABSOLUTE_ODOMETER
        </query>
      </dbQuery>
    </select>
  </data>

  <!--
    [NEEDS_REVIEW] CALC_CALC_DEF_2
    Загрузка пикетов (PIKET) для интерполяции координат.
    Источник: IliInspCalcService.js — шаг "load_def", таблица PIKET.
    Oracle-оригинал: предположительно SELECT из PODS.STATION_POINT.
    Алгоритм IliInspCalc.interpolate() ожидает поля: STATION, DISTANCE, X, Y, Z.

    ⚠ NEEDS_REVIEW: точный список полей и условия фильтрации.
    Параметр: :P_ROUTE_ID
  -->
  <data id="CALC_CALC_DEF_2">
    <select>
      <dbQuery>
        <param name="P_ROUTE_ID"/>
        <query>
SELECT
  STATION_POINT_ID AS ID,
  STATION,
  DISTANCE,
  X,
  Y,
  Z
FROM STATION_POINT
WHERE ROUTE_ID = :P_ROUTE_ID
ORDER BY STATION, DISTANCE
        </query>
      </dbQuery>
    </select>
  </data>

  <!--
    [NEEDS_REVIEW] CALC_CALC_DEF_3
    Запись рассчитанных координат дефектов в EVENT_RANGE.
    Вызывается через dbWriter (построчно).
    Источник: IliInspCalcService.js — шаг "write_def".
    Oracle-оригинал: предположительно INSERT INTO PODS.EVENT_RANGE.

    ⚠ NEEDS_REVIEW: структура таблицы EVENT_RANGE и список полей результата
      IliInspCalc.process() (таблица RES).
    Поля из RES: :ILI_DATA_ID, :P_REPORT_ID, :P_ROUTE_ID,
      :STATION_FROM, :DISTANCE_FROM, :STATION_TO, :DISTANCE_TO, :X, :Y, :Z
